# Contact form email delivery, via Resend (https://resend.com).
# Server-only — never exposed to the browser. Copy this file to .env.local
# and fill in real values there (.env.local is gitignored).

# Required. Get a key from https://resend.com/api-keys.
# Example format only — NOT a real key.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# The verified sender address/domain in Resend. Leave unset to fall back to
# Resend's shared sandbox address (onboarding@resend.dev), which works
# without domain verification but is best for testing only. Once
# ambalimustapha.dev is verified in Resend, set this to something like
# contact@ambalimustapha.dev.
CONTACT_FROM_EMAIL=

# Where contact form submissions are delivered. Defaults to hello@ambalimustapha.dev
# (set in lib/constants.ts) if left blank — only override if you need to send
# submissions somewhere else.
CONTACT_TO_EMAIL=hello@ambalimustapha.dev
